# ============================================
# Microsoft Integration Server - Configuration
# ============================================
# Copy this file to .env and fill in your values
# All values are loaded from environment - NO hardcoded credentials

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3007
NODE_ENV=production

# Public URL for webhooks (required for subscriptions)
# This is the public-facing URL that Microsoft will call
PUBLIC_URL=https://your-webhook-domain.com
WEBHOOK_BASE_URL=https://your-webhook-domain.com

# Graph Helper server port (optional, for ms-graph-helper.js)
GRAPH_HELPER_PORT=3008

# OAuth callback port (for generate-token.js)
OAUTH_CALLBACK_PORT=3001
OAUTH_REDIRECT_URI=http://localhost:3001/oauth/callback

# Default agent for CLI tools when --agent not specified
DEFAULT_AGENT=agent1

# ============================================
# FEATURE FLAGS
# ============================================
# Disable calendar notifications forwarding
FORWARD_CALENDAR_NOTIFICATIONS=true

# Enable debug logging
DEBUG=false

# ============================================
# ENABLED AGENTS
# ============================================
# Comma-separated list of agent names to enable
# If not set, auto-detects from *_CLIENT_ID variables
ENABLED_AGENTS=agent1,agent2

# ============================================
# AGENT CONFIGURATION TEMPLATE
# ============================================
# Repeat this block for each agent
# Replace AGENT1 with your agent's name in UPPERCASE
#
# Required fields:
# - {AGENT}_CLIENT_ID: Azure App Registration Client ID
# - {AGENT}_TENANT_ID: Azure Tenant ID  
# - {AGENT}_TOKEN_FILE: Path to token JSON file
# - {AGENT}_GATEWAY_URL: OpenClaw gateway webhook URL
# - {AGENT}_GATEWAY_TOKEN: OpenClaw gateway auth token
#
# Optional fields:
# - {AGENT}_CLIENT_SECRET: Azure Client Secret (for confidential apps)
# - {AGENT}_DISPLAY_NAME: Human-readable name
# - {AGENT}_AGENT_ID: Agent ID (defaults to lowercase name)
# - {AGENT}_EMAIL: Agent's email address

# ============================================
# AGENT 1 (example - rename to your agent)
# ============================================
AGENT1_CLIENT_ID=your-azure-client-id
AGENT1_TENANT_ID=your-azure-tenant-id
AGENT1_TOKEN_FILE=/path/to/agent1-microsoft-tokens.json
AGENT1_GATEWAY_URL=http://localhost:18789/hooks/agent
AGENT1_GATEWAY_TOKEN=your-gateway-token
AGENT1_DISPLAY_NAME=Agent One
AGENT1_AGENT_ID=agent1
AGENT1_EMAIL=agent1@example.com

# ============================================
# AGENT 2 (example - rename to your agent)
# ============================================
# AGENT2_CLIENT_ID=your-azure-client-id
# AGENT2_TENANT_ID=your-azure-tenant-id
# AGENT2_TOKEN_FILE=/path/to/agent2-microsoft-tokens.json
# AGENT2_GATEWAY_URL=http://localhost:19789/hooks/agent
# AGENT2_GATEWAY_TOKEN=your-gateway-token
# AGENT2_DISPLAY_NAME=Agent Two
# AGENT2_AGENT_ID=agent2
# AGENT2_EMAIL=agent2@example.com

# ============================================
# OAUTH SCOPES (optional override)
# ============================================
# Space-separated list of Microsoft Graph scopes
# If not set, uses sensible defaults for full functionality
# OAUTH_SCOPES=User.Read Mail.Read Mail.Send Calendars.ReadWrite Chat.ReadWrite offline_access

# ============================================
# SESSION STORE CONFIGURATION
# ============================================
# Conversation history is stored locally to provide context
# across messages since OpenClaw hooks don't maintain sessions

# Maximum messages to keep per session (older are truncated)
SESSION_MAX_MESSAGES=30

# Number of recent messages to inject into each prompt
SESSION_INJECT_MESSAGES=10

# Database location (SQLite, created automatically)
# SESSION_DB_PATH=./data/sessions.db

# ============================================
# CLOUDFLARE TUNNEL CONFIGURATION
# ============================================
# Cloudflare Tunnel provides secure webhook ingress without exposing ports
# Run: ms-middleware tunnel setup

# API token with these permissions:
# - Account > Cloudflare Tunnel > Edit
# - Zone > DNS > Edit (for your domain)
CLOUDFLARE_API_TOKEN=

# Your Cloudflare account ID (found in dashboard URL or API)
CLOUDFLARE_ACCOUNT_ID=

# Domain for webhook URL (must be in your Cloudflare account)
CLOUDFLARE_DOMAIN=example.com

# Subdomain for webhook (default: microsoft)
# Final URL will be: https://{subdomain}.{domain}
CLOUDFLARE_SUBDOMAIN=microsoft

# Tunnel name (default: ms-middleware)
CLOUDFLARE_TUNNEL_NAME=ms-middleware
