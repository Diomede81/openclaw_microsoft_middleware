# Server Configuration
PORT=3007
NODE_ENV=production

# ============================================
# AGENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env and fill in values for each agent
# Repeat this block for each agent (MAX_, SOPHIA_, KIM_, etc.)
#
# Required fields for each agent:
# - {AGENT}_CLIENT_ID: Azure App Registration Client ID
# - {AGENT}_TENANT_ID: Azure Tenant ID
# - {AGENT}_TOKEN_FILE: Path to Microsoft token JSON file
# - {AGENT}_GATEWAY_URL: OpenClaw gateway webhook URL
# - {AGENT}_GATEWAY_TOKEN: OpenClaw gateway auth token
# - {AGENT}_DISPLAY_NAME: Agent's display name in Microsoft Teams
# - {AGENT}_AGENT_ID: (optional) Agent ID for gateway, defaults to lowercase agent name
#
# Example for an agent named "MAX":

# MAX_CLIENT_ID=your-azure-client-id
# MAX_TENANT_ID=your-azure-tenant-id
# MAX_TOKEN_FILE=/path/to/max-microsoft-tokens.json
# MAX_GATEWAY_URL=http://localhost:18789/hooks/agent
# MAX_GATEWAY_TOKEN=your-gateway-token-here
# MAX_DISPLAY_NAME=Max Ferretti
# MAX_AGENT_ID=max

# Add more agents by duplicating the pattern above with different prefixes
# SOPHIA_CLIENT_ID=...
# SOPHIA_TENANT_ID=...
# etc.
